; Benchmarks (docs/perf/method.md), always in the release profile:
;   dune build --profile release @bench
;   dune exec --profile release bench/run.exe -- --csv docs/perf/results.csv

(executable
 (name run)
 (libraries riscv unix))

(rule
 (alias bench)
 (deps
  run.exe
  (glob_files micro/*.s)
  (glob_files micro/*.expected))
 (action
  (run %{dep:run.exe})))
